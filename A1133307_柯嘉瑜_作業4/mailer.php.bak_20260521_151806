<?php
/**
 * mailer.php — PHPMailer 寄信核心
 * 使用方式：在 index.php 中 require 此檔案
 * 
 * 資料夾結構假設（請確認你的 PHPMailer 資料夾名稱）：
 * /your-project/
 *   index.php
 *   mailer.php          ← 本檔案
 *   PHPMailer/
 *     src/
 *       PHPMailer.php
 *       SMTP.php
 *       Exception.php
 */

use PHPMailer\PHPMailer\PHPMailer;
use PHPMailer\PHPMailer\SMTP;
use PHPMailer\PHPMailer\Exception;

// ── 自動載入 PHPMailer ────────────────────────────────────────────
// 如果你的資料夾名稱不同（例如 phpmailer、PHPMailer-master），請修改下面路徑
$phpmailerBase = __DIR__ . '/PHPMailer/src/';
if (!file_exists($phpmailerBase . 'PHPMailer.php')) {
    // 嘗試其他常見資料夾名稱
    $candidates = [
        __DIR__ . '/phpmailer/src/',
        __DIR__ . '/PHPMailer-master/src/',
        __DIR__ . '/vendor/phpmailer/phpmailer/src/',
    ];
    foreach ($candidates as $c) {
        if (file_exists($c . 'PHPMailer.php')) {
            $phpmailerBase = $c;
            break;
        }
    }
}

require $phpmailerBase . 'Exception.php';
require $phpmailerBase . 'PHPMailer.php';
require $phpmailerBase . 'SMTP.php';

/**
 * sendMail() — 統一寄信函式
 *
 * @param array $params 包含以下 key：
 *   to           string  收件人 Email（必填）
 *   subject      string  郵件主旨（必填）
 *   body         string  HTML 郵件內文（必填）
 *   from_name    string  寄件人名稱（選填，預設 Mail System）
 *   from_email   string  寄件人 Email（選填，預設使用 SMTP 帳號）
 *   confidential bool    機密模式（選填，預設 false）
 *
 * @return array ['success'=>bool, 'message'=>string]
 */
function sendMail(array $params): array
{
    // ── SMTP 設定（請填入你的帳號資訊）─────────────────────────────
    $smtpHost     = 'smtp.gmail.com';   // Gmail SMTP 主機
    $smtpPort     = 587;                // TLS Port（SSL 用 465）
    $smtpUser     = 'a1133307@mail.nuk.edu.tw';   // ← 改成你的 Gmail
    $smtpPass     = 'kpgy yqlg emob aqgd';      // ← 改成 Google App 密碼（16碼）
    $smtpSecure   = PHPMailer::ENCRYPTION_STARTTLS; // 或 ENCRYPTION_SMTPS（Port 465）
    // ─────────────────────────────────────────────────────────────

    $to           = trim($params['to']         ?? '');
    $subject      = trim($params['subject']    ?? '（無主旨）');
    $body         = $params['body']             ?? '';
    $fromName     = trim($params['from_name']  ?? 'Mail System');
    $fromEmail    = trim($params['from_email'] ?? $smtpUser);
    $confidential = !empty($params['confidential']);

    // 驗證收件人
    if (!filter_var($to, FILTER_VALIDATE_EMAIL)) {
        return ['success' => false, 'message' => '收件人格式錯誤'];
    }

    // 機密模式橫幅
    $banner = '';
    if ($confidential) {
        $banner = '
        <div style="
            background:#ef4444;
            color:#ffffff;
            padding:10px 16px;
            border-radius:6px;
            margin-bottom:16px;
            font-family:Arial,sans-serif;
            font-weight:bold;
            font-size:14px;
        ">
            🔒 機密郵件｜請勿轉寄、截圖或複製本郵件
        </div>';
    }

    // 組合完整 HTML
    $html = '<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>' . htmlspecialchars($subject) . '</title>
</head>
<body style="margin:0; padding:20px; font-family:\'Noto Sans TC\', Arial, sans-serif; background:#f8fafc; color:#1e293b;">
    <div style="max-width:640px; margin:0 auto; background:#ffffff; border-radius:10px; overflow:hidden; box-shadow:0 2px 12px rgba(0,0,0,0.08);">
        <div style="padding:24px 28px;">
            ' . $banner . '
            ' . $body . '
        </div>
        <div style="background:#f1f5f9; padding:12px 28px; font-size:11px; color:#94a3b8; border-top:1px solid #e2e8f0;">
            此郵件由 ' . htmlspecialchars($fromName) . ' 寄送
            ' . ($confidential ? '｜<strong style="color:#ef4444;">機密郵件，請勿外傳</strong>' : '') . '
        </div>
    </div>
</body>
</html>';

    // ── 建立 PHPMailer 實例並寄送 ────────────────────────────────
    $mail = new PHPMailer(true);
    try {
        // 伺服器設定
        $mail->isSMTP();
        $mail->Host       = $smtpHost;
        $mail->SMTPAuth   = true;
        $mail->Username   = $smtpUser;
        $mail->Password   = $smtpPass;
        $mail->SMTPSecure = $smtpSecure;
        $mail->Port       = $smtpPort;
        $mail->CharSet    = 'UTF-8';
        $mail->Encoding   = 'base64';

        // 除錯（上線時改為 0，開發時可設 2）
        $mail->SMTPDebug  = 0;

        // 寄件人 & 收件人
        $mail->setFrom($smtpUser, $fromName);    // From 固定用 SMTP 帳號避免被擋
        $mail->addReplyTo($fromEmail, $fromName); // Reply-To 可自訂
        $mail->addAddress($to);

        // 郵件內容
        $mail->isHTML(true);
        $mail->Subject = $subject;
        $mail->Body    = $html;
        $mail->AltBody = strip_tags(str_replace(['<br>', '<br/>', '<br />'], "\n", $body));

        // 機密模式額外 Header（Gmail 不強制，但可加）
        if ($confidential) {
            $mail->addCustomHeader('X-Confidential', 'true');
            $mail->addCustomHeader('Sensitivity', 'Company-Confidential');
        }

        $mail->send();
        return ['success' => true, 'to' => $to, 'message' => '寄送成功'];

    } catch (Exception $e) {
        return [
            'success' => false,
            'to'      => $to,
            'message' => '寄送失敗：' . $mail->ErrorInfo
        ];
    }
}

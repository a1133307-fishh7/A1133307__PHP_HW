<?php
session_start();

// 載入 PHPMailer 寄信模組
require_once __DIR__ . '/mailer.php';

// Database Setup (SQLite)
try {
    $db = new PDO('sqlite:' . __DIR__ . '/emails.sqlite');
    $db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
    $db->exec("CREATE TABLE IF NOT EXISTS emails (
        id    INTEGER PRIMARY KEY AUTOINCREMENT,
        email TEXT UNIQUE NOT NULL,
        created_at DATETIME DEFAULT CURRENT_TIMESTAMP
    )");
} catch (Exception $e) {
    if (!empty($_POST['action']) || !empty($_GET['action'])) {
        header('Content-Type: application/json');
        die(json_encode(['success' => false, 'message' => $e->getMessage()]));
    }
    die('<h3 style="color:red">資料庫錯誤：' . htmlspecialchars($e->getMessage()) . '</h3>');
}

// AJAX Routing
$action = $_POST['action'] ?? $_GET['action'] ?? '';
if ($action) {
    header('Content-Type: application/json');
    switch ($action) {

        case 'add_email':
            $email = filter_var(trim($_POST['email'] ?? ''), FILTER_VALIDATE_EMAIL);
            if (!$email) { echo json_encode(['success'=>false,'message'=>'無效的 Email 格式']); exit; }
            try {
                $db->prepare("INSERT INTO emails (email) VALUES (?)")->execute([$email]);
                echo json_encode(['success'=>true,'id'=>$db->lastInsertId(),'email'=>$email]);
            } catch (Exception $e) {
                echo json_encode(['success'=>false,'message'=>'此 Email 已存在於資料庫']);
            }
            exit;

        case 'add_bulk':
            $lines = explode("\n", $_POST['emails'] ?? '');
            $added = 0; $failed = 0; $dupes = 0;
            foreach ($lines as $line) {
                $e = filter_var(trim($line), FILTER_VALIDATE_EMAIL);
                if (!$e) { $failed++; continue; }
                try {
                    $db->prepare("INSERT INTO emails (email) VALUES (?)")->execute([$e]);
                    $added++;
                } catch (Exception $ex) { $dupes++; }
            }
            echo json_encode(['success'=>true,'added'=>$added,'failed'=>$failed,'dupes'=>$dupes]);
            exit;

        case 'delete_email':
            $db->prepare("DELETE FROM emails WHERE id=?")->execute([intval($_POST['id']??0)]);
            echo json_encode(['success'=>true]);
            exit;

        case 'clear_all':
            $db->exec("DELETE FROM emails");
            echo json_encode(['success'=>true]);
            exit;

        case 'get_emails':
            $stmt = $db->query("SELECT * FROM emails ORDER BY id ASC");
            echo json_encode(['emails'=>$stmt->fetchAll(PDO::FETCH_ASSOC)]);
            exit;

        case 'get_count':
            echo json_encode(['count'=>(int)$db->query("SELECT COUNT(*) FROM emails")->fetchColumn()]);
            exit;

        case 'get_random':
            $n = max(1, intval($_POST['n'] ?? 1));
            $stmt = $db->query("SELECT * FROM emails ORDER BY RANDOM() LIMIT $n");
            echo json_encode(['emails'=>$stmt->fetchAll(PDO::FETCH_ASSOC)]);
            exit;

        case 'send_one':
            // 使用 PHPMailer 寄信
            $result = sendMail([
                'to'           => trim($_POST['to']          ?? ''),
                'subject'      => trim($_POST['subject']     ?? '（無主旨）'),
                'body'         => $_POST['body']              ?? '',
                'from_name'    => trim($_POST['from_name']   ?? 'Mail System'),
                'from_email'   => trim($_POST['from_email']  ?? ''),
                'confidential' => (($_POST['confidential'] ?? '0') === '1'),
            ]);
            echo json_encode($result);
            exit;
    }
    exit;
}


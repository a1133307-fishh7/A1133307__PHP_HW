      <label>替代文字（Alt）</label>
      <input type="text" id="imgAlt" placeholder="圖片描述（選填）">
    </div>
    <div class="form-row">
      <label>寬度</label>
      <input type="text" id="imgWidth" placeholder="例：100% 或 400px">
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeImgModal()">取消</button>
      <button class="btn btn-primary" onclick="doInsertImg()">插入</button>
    </div>
  </div>
</div>

<div class="toast-container" id="toastContainer"></div>

<script>
// Tab switching
function switchTab(id, btn) {
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-tab').forEach(b => b.classList.remove('active'));
  document.getElementById('tab-' + id).classList.add('active');
  btn.classList.add('active');
}

// Toast
function toast(msg, type='info', dur=3000) {
  const icons = {success:'✅',error:'❌',info:'ℹ️'};
  const t = document.createElement('div');
  t.className = `toast ${type}`;
  t.innerHTML = `<span>${icons[type]}</span><span>${msg}</span>`;
  document.getElementById('toastContainer').appendChild(t);
  setTimeout(() => t.remove(), dur);
}

// API helper
async function api(data) {
  const fd = new FormData();
  for (const [k,v] of Object.entries(data)) fd.append(k,v);
  return (await fetch('', {method:'POST', body:fd})).json();
}

// Load emails
async function loadEmails() {
  renderList((await api({action:'get_emails'})).emails || []);
}
function renderList(emails) {
  const cnt = emails.length;
  document.getElementById('statTotal').textContent  = cnt;
  document.getElementById('listCount').textContent  = `共 ${cnt} 筆`;
  document.getElementById('headerBadge').textContent = `📧 ${cnt} 個 Email`;
  if (cnt) document.getElementById('statLast').textContent = emails[cnt-1]?.email || '—';
  const list = document.getElementById('emailList');
  if (!cnt) { list.innerHTML = '<div class="empty-state"><div class="icon">📭</div><div>尚無 Email，請先新增</div></div>'; return; }
  list.innerHTML = emails.map((e,i) => `
    <div class="email-item" id="row-${e.id}">
      <span class="email-no">#${i+1}</span>
      <span class="email-addr">${esc(e.email)}</span>
      <span class="email-time">${e.created_at?.slice(5,16)||''}</span>
      <button class="del-btn" onclick="deleteEmail(${e.id})">🗑</button>
    </div>`).join('');
}
function esc(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

async function addSingle() {
  const input = document.getElementById('singleEmail');
  const r = await api({action:'add_email', email:input.value.trim()});
  if (r.success) { toast(`已新增 ${r.email}`,'success'); input.value=''; loadEmails(); }
  else toast(r.message||'新增失敗','error');
}
async function addBulk() {
  const emails = document.getElementById('bulkEmails').value.trim();
  if (!emails) return;
  const r = await api({action:'add_bulk', emails});
  if (r.success) { toast(`新增 ${r.added} 筆 | 重複 ${r.dupes} | 格式錯誤 ${r.failed}`,'success',4000); document.getElementById('bulkEmails').value=''; loadEmails(); }
}
async function deleteEmail(id) { if ((await api({action:'delete_email',id})).success) { loadEmails(); toast('已刪除','info'); } }
async function clearAll() {
  if (!confirm('確定要清空所有 Email？')) return;
  await api({action:'clear_all'}); toast('已清空','info'); loadEmails();
}

// Rich editor
function execCmd(cmd,val=null){ document.getElementById('editor').focus(); document.execCommand(cmd,false,val); }
function setColor(c){ document.getElementById('colorPicker').classList.remove('open'); execCmd('foreColor',c); }
function setHighlight(c){ document.getElementById('hlPicker').classList.remove('open'); execCmd('backColor',c==='transparent'?'#ffffff':c); }
function toggleColorPicker(){ document.getElementById('hlPicker').classList.remove('open'); document.getElementById('colorPicker').classList.toggle('open'); }
function toggleHighlight(){ document.getElementById('colorPicker').classList.remove('open'); document.getElementById('hlPicker').classList.toggle('open'); }

let savedRange = null;
function saveRange(){ const s=window.getSelection(); if(s.rangeCount) savedRange=s.getRangeAt(0).cloneRange(); }
function restoreRange(){ if(!savedRange) return; const s=window.getSelection(); s.removeAllRanges(); s.addRange(savedRange); }

function toggleEmoji(e){ e.stopPropagation(); saveRange(); document.getElementById('emojiPicker').classList.toggle('open'); }
function insertEmoji(em){ restoreRange(); document.getElementById('editor').focus(); document.execCommand('insertText',false,em); document.getElementById('emojiPicker').classList.remove('open'); }

function openImgModal(){ saveRange(); document.getElementById('imgModal').classList.add('open'); document.getElementById('imgUrl').focus(); }
function closeImgModal(){ document.getElementById('imgModal').classList.remove('open'); }
function doInsertImg(){
  const url=document.getElementById('imgUrl').value.trim();
  if (!url){ toast('請輸入圖片 URL','error'); return; }
  const alt=document.getElementById('imgAlt').value.trim()||'image';
  const width=document.getElementById('imgWidth').value.trim()||'100%';
  restoreRange(); document.getElementById('editor').focus();
  document.execCommand('insertHTML',false,`<img src="${url}" alt="${alt}" style="max-width:${width};display:block;margin:6px 0">`);
  closeImgModal(); ['imgUrl','imgAlt','imgWidth'].forEach(id=>document.getElementById(id).value='');
}
function insertLink(){
  const url=prompt('輸入連結 URL：','https://'); if(!url) return;
  const text=prompt('連結顯示文字（空白則用 URL）：','')||url;
  document.getElementById('editor').focus();
  document.execCommand('insertHTML',false,`<a href="${url}" target="_blank" style="color:#3b82f6">${text}</a>`);
}

document.addEventListener('click', e => {
  if (!e.target.closest('#colorBtn') && !e.target.closest('#colorPicker')) document.getElementById('colorPicker').classList.remove('open');
  if (!e.target.closest('#hlBtn')   && !e.target.closest('#hlPicker'))    document.getElementById('hlPicker').classList.remove('open');
  if (!e.target.closest('.emoji-wrap')) document.getElementById('emojiPicker').classList.remove('open');
});
document.getElementById('imgModal').addEventListener('click', e => { if(e.target===document.getElementById('imgModal')) closeImgModal(); });

function toggleConfBadge(){ document.getElementById('confBadge').classList.toggle('show', document.getElementById('confidentialToggle').checked); }
function updateSendMode(){ document.getElementById('randomCount').style.display = document.querySelector('input[name=sendMode]:checked').value==='random'?'block':'none'; }
function updateIntervalMode(){
  const r = document.querySelector('input[name=intervalMode]:checked').value==='random';
  document.getElementById('fixedSec').style.display  = r?'none':'block';
  document.getElementById('randomSec').style.display = r?'block':'none';
}

// Send logic
let sendQueue=[],sendIdx=0,isSending=false,sendTimer=null;

async function startSend(){
  const subject=document.getElementById('mailSubject').value.trim();
  const body=document.getElementById('editor').innerHTML.trim();
  if (!subject){ toast('請填寫郵件主旨','error'); return; }
  if (!body)   { toast('請填寫郵件內容','error'); return; }

  const mode=document.querySelector('input[name=sendMode]:checked').value;
  let emailData;
  if (mode==='random'){
    const n=parseInt(document.getElementById('randomN').value)||1;
    emailData=await api({action:'get_random',n});
  } else { emailData=await api({action:'get_emails'}); }
  const emails=(emailData.emails||[]).map(e=>e.email);
  if (!emails.length){ toast('資料庫中沒有 Email','error'); return; }

  sendQueue=emails; sendIdx=0; isSending=true;
  document.getElementById('sendBtn').style.display='none';
  document.getElementById('stopBtn').style.display='';
  document.getElementById('progressWrap').style.display='block';
  document.getElementById('sendLog').innerHTML='';
  updateProgress(0,emails.length,'準備寄送…');
  sendNext();
}

async function sendNext(){
  if (!isSending||sendIdx>=sendQueue.length){ finishSend(); return; }
  const to=sendQueue[sendIdx];
  updateProgress(sendIdx,sendQueue.length,`正在寄送至 ${to}…`);

  const r=await api({
    action:'send_one', to,
    from_name:   document.getElementById('fromName').value,
    from_email:  document.getElementById('fromEmail').value,
    subject:     document.getElementById('mailSubject').value,
    body:        document.getElementById('editor').innerHTML,
    confidential:document.getElementById('confidentialToggle').checked?'1':'0',
  });

  appendLog(r.success
    ?`<span class="log-ok">✅ [${sendIdx+1}/${sendQueue.length}] ${to} — 寄送成功</span>`
    :`<span class="log-fail">❌ [${sendIdx+1}/${sendQueue.length}] ${to} — ${r.message}</span>`);
  sendIdx++;
  if (sendIdx>=sendQueue.length){ finishSend(); return; }

  const intMode=document.querySelector('input[name=intervalMode]:checked').value;
  let delay;
  if (intMode==='random'){
    const mn=parseFloat(document.getElementById('minSec').value)||1;
    const mx=parseFloat(document.getElementById('maxSec').value)||5;
    delay=(mn+Math.random()*(mx-mn))*1000;
    appendLog(`<span class="log-info">⏱ 隨機等待 ${(delay/1000).toFixed(1)}s…</span>`);
  } else {
    delay=(parseFloat(document.getElementById('intervalSec').value)||0)*1000;
    if (delay>0) appendLog(`<span class="log-info">⏱ 等待 ${(delay/1000).toFixed(1)}s…</span>`);
  }
  sendTimer=setTimeout(sendNext,delay);
}

function finishSend(){
  isSending=false;
  updateProgress(sendIdx,sendQueue.length,'✅ 寄送完成！');
  document.getElementById('sendBtn').style.display='';
  document.getElementById('stopBtn').style.display='none';
  appendLog(`<span class="log-info">══ 完成：共寄出 ${sendIdx} 封 ══</span>`);
  toast(`寄送完成！共 ${sendIdx} 封`,'success',5000);
}
function stopSend(){
  isSending=false; clearTimeout(sendTimer);
  document.getElementById('sendBtn').style.display='';
  document.getElementById('stopBtn').style.display='none';
  appendLog(`<span class="log-fail">⏹ 已停止（已寄 ${sendIdx}/${sendQueue.length} 封）</span>`);
  toast('已停止寄送','info');
}
function updateProgress(cur,total,label){
  const pct=total>0?Math.round((cur/total)*100):0;
  document.getElementById('progressFill').style.width=pct+'%';
  document.getElementById('progressPct').textContent=pct+'%';
  document.getElementById('progressText').textContent=label;
}
function appendLog(html){
  const log=document.getElementById('sendLog');
  log.innerHTML+=html+'<br>';
  log.scrollTop=log.scrollHeight;
}

loadEmails();
</script>
</body>
</html>
